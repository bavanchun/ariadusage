{
  "$defs": {
    "AccountSnapshot": {
      "description": "Snapshot of an individual account within a multi-account provider.",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric3"
            },
            {
              "type": "null"
            }
          ]
        },
        "credits": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric2"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric4"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "string"
        },
        "lastError": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderError"
            },
            {
              "type": "null"
            }
          ]
        },
        "pace": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric6"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric5"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "windows": {
          "$ref": "#/$defs/ProviderWindows",
          "default": {}
        }
      },
      "required": [
        "id",
        "label",
        "active"
      ],
      "type": "object"
    },
    "ActionId": {
      "description": "A unique identifier for a provider action (1–64 characters, `[a-zA-Z0-9_.-]`).",
      "pattern": "^[a-zA-Z0-9_.-]{1,64}$",
      "type": "string"
    },
    "Chart": {
      "description": "A chart embedded in a detail section.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ChartKind"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ChartPoint"
          },
          "maxItems": 120,
          "type": "array"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "points"
      ],
      "type": "object"
    },
    "ChartKind": {
      "description": "Kind of chart to render.",
      "enum": [
        "bars",
        "line"
      ],
      "type": "string"
    },
    "ChartPoint": {
      "description": "A data point in a chart.",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "type": "object"
    },
    "ClientInfo": {
      "description": "Information identifying the client in the `hello` handshake message.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "ClientMessage": {
      "description": "Messages sent from client to server.",
      "oneOf": [
        {
          "description": "Initial client handshake advertising supported protocols and client metadata.",
          "properties": {
            "client": {
              "$ref": "#/$defs/ClientInfo"
            },
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "protocols": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "hello",
              "type": "string"
            }
          },
          "required": [
            "type",
            "protocols",
            "client"
          ],
          "type": "object"
        },
        {
          "description": "Subscribe to pushed update topics.",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "topics": {
              "items": {
                "$ref": "#/$defs/Topic"
              },
              "type": "array"
            },
            "type": {
              "const": "subscribe",
              "type": "string"
            }
          },
          "required": [
            "type",
            "topics"
          ],
          "type": "object"
        },
        {
          "description": "Request an immediate usage snapshot push.",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "getSnapshot",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Trigger an immediate refresh for all providers or a specific provider.",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "provider": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProviderId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "refresh",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Fetch settings descriptors for the given scope.",
          "properties": {
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "scope": {
              "$ref": "#/$defs/SettingsScope"
            },
            "type": {
              "const": "getSettings",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scope"
          ],
          "type": "object"
        },
        {
          "description": "Modify a non-secret setting value.",
          "properties": {
            "id": {
              "$ref": "#/$defs/SettingId"
            },
            "type": {
              "const": "setSetting",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "type",
            "id",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Run a provider action.",
          "properties": {
            "confirm": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "id": {
              "$ref": "#/$defs/ActionId"
            },
            "type": {
              "const": "runAction",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "Store a sensitive secret (e.g. API token). Never echoed or logged.",
          "properties": {
            "id": {
              "$ref": "#/$defs/SettingId"
            },
            "type": {
              "const": "setSecret",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/SecretString"
            }
          },
          "required": [
            "type",
            "id",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Confidence": {
      "description": "Confidence level in a metric value.",
      "enum": [
        "exact",
        "estimated",
        "percentOnly",
        "unknown"
      ],
      "type": "string"
    },
    "Cost": {
      "description": "Cost and spend tracking snapshot.",
      "properties": {
        "balance": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "currencyCode": {
          "type": "string"
        },
        "limit": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "resetsAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "used": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "used",
        "currencyCode"
      ],
      "type": "object"
    },
    "Credits": {
      "description": "Token or service credits snapshot.",
      "properties": {
        "balanceIsWorkspace": {
