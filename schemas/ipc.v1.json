        "unknown"
      ],
      "type": "string"
    },
    "NamedWindow": {
      "description": "A named rate window for secondary/tertiary/custom provider allowances.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "id",
        "title",
        "window"
      ],
      "type": "object"
    },
    "NoticeLevel": {
      "description": "Severity level for asynchronous notice messages pushed by the server.",
      "enum": [
        "info",
        "warning",
        "error",
        "unknown"
      ],
      "type": "string"
    },
    "Pace": {
      "description": "Pace metrics comparing consumption to linear time progression.",
      "properties": {
        "deltaPercent": {
          "format": "double",
          "type": "number"
        },
        "etaSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "expectedUsedPercent": {
          "format": "double",
          "type": "number"
        },
        "stage": {
          "$ref": "#/$defs/PaceStage"
        },
        "summary": {
          "type": "string"
        },
        "willLastToReset": {
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "deltaPercent",
        "expectedUsedPercent",
        "willLastToReset",
        "summary"
      ],
      "type": "object"
    },
    "PaceStage": {
      "description": "Progression stage for usage pace.",
      "enum": [
        "onTrack",
        "slightlyAhead",
        "ahead",
        "farAhead",
        "slightlyBehind",
        "behind",
        "farBehind",
        "unknown"
      ],
      "type": "string"
    },
    "ProviderError": {
      "description": "A classified provider error with a safe message.",
      "properties": {
        "category": {
          "$ref": "#/$defs/ProviderErrorCategory"
        },
        "kind": {
          "$ref": "#/$defs/ProviderErrorKind"
        },
        "message": {
          "type": "string"
        },
        "retryAfterSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "category",
        "message"
      ],
      "type": "object"
    },
    "ProviderErrorCategory": {
      "description": "High-level diagnostic categories.",
      "enum": [
        "auth",
        "api",
        "parse",
        "network",
        "configuration",
        "unknown"
      ],
      "type": "string"
    },
    "ProviderErrorKind": {
      "description": "Classified error kinds matching CodexBar's error model.",
      "enum": [
        "authentication-expired",
        "missing-credential",
        "permission-denied",
        "rate-limited",
        "provider-unavailable",
        "parse-failure",
        "network-failure",
        "api-failure",
        "unknown"
      ],
      "type": "string"
    },
    "ProviderId": {
      "description": "A unique identifier for a provider instance (1–64 characters, `[a-z0-9-]`).\n\nFollows the same grammar and length restrictions as CodexBar's `ProviderInstanceID`.",
      "pattern": "^[a-z0-9-]{1,64}$",
      "type": "string"
    },
    "ProviderSnapshot": {
      "description": "Snapshot of a single AI provider's usage and state.",
      "properties": {
        "accounts": {
          "items": {
            "$ref": "#/$defs/AccountSnapshot"
          },
          "type": "array"
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric3"
            },
            {
              "type": "null"
            }
          ]
        },
        "credits": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric2"
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "items": {
            "$ref": "#/$defs/DetailSection"
          },
          "maxItems": 8,
          "type": "array"
        },
        "displayName": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/ProviderId"
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric4"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastError": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderError"
            },
            {
              "type": "null"
            }
          ]
        },
        "pace": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric6"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceMode": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric5"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "windows": {
          "$ref": "#/$defs/ProviderWindows",
          "default": {}
        }
      },
      "required": [
        "id",
        "displayName",
        "enabled",
        "sourceMode"
      ],
      "type": "object"
    },
    "ProviderWindows": {
      "description": "Positional and named rate windows for a provider or account.",
      "properties": {
        "extra": {
          "items": {
            "$ref": "#/$defs/NamedWindow"
          },
          "type": "array"
        },
        "primary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "tertiary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "RateWindow": {
      "description": "A rate window indicating quota consumption and reset timing.",
      "properties": {
        "nextRegenPercent": {
          "description": "Percentage restored on next regeneration increment, if applicable.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "resetDescription": {
          "description": "Human-readable description of reset timing (e.g. \"Resets tomorrow at 9 AM\").",
          "type": [
            "string",
            "null"
          ]
        },
        "resetsAt": {
          "description": "Timestamp when this window resets.",
          "type": [
            "string",
            "null"
          ]
        },
        "usedPercent": {
          "description": "Percentage of quota consumed (raw, may exceed 100%).",
          "format": "double",
          "type": "number"
        },
        "windowMinutes": {
          "description": "Duration of the window in minutes (e.g. 300 for 5 hours, 10080 for weekly).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "usedPercent"
      ],
      "type": "object"
    },
    "RequestId": {
      "description": "A unique identifier for a client request (1–64 characters, ASCII graphic characters).",
      "pattern": "^[\\x21-\\x7E]{1,64}$",
      "type": "string"
    },
    "RowProgress": {
      "description": "Numeric ratio progress for a detail row.",
      "properties": {
        "total": {
          "format": "double",
          "type": "number"
        },
        "used": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "used",
        "total"
      ],
      "type": "object"
    },
    "SecretString": {
      "description": "A secret string that redacts itself in [`fmt::Debug`], does not implement [`fmt::Display`],\nand zeroizes its memory buffer when dropped.\n\nSerialized and deserialized as a standard string for wire transport (e.g. `setSecret` frame).",
      "type": "string"
    },
    "ServerMessage": {
      "description": "Messages sent from server to client.",
      "oneOf": [
        {
          "description": "Handshake response confirming negotiated protocol and engine capabilities.",
          "properties": {
            "capabilities": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "engineVersion": {
              "type": "string"
            },
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "protocol": {
              "type": "string"
            },
            "type": {
              "const": "welcome",
              "type": "string"
            }
          },
          "required": [
            "type",
            "protocol",
            "engineVersion",
            "capabilities"
          ],
          "type": "object"
        },
        {
          "description": "Explicit response to a client request.",
          "properties": {
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/IpcError"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ok": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "payload": true,
            "type": {
              "const": "response",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Pushed engine usage snapshot.",
          "properties": {
            "snapshot": {
              "$ref": "#/$defs/EngineSnapshot"
            },
            "type": {
              "const": "snapshot",
              "type": "string"
            }
          },
          "required": [
            "type",
            "snapshot"
          ],
          "type": "object"
        },
        {
          "description": "Pushed notification that settings in `scope` have changed.",
          "properties": {
            "scope": {
              "$ref": "#/$defs/SettingsScope"
            },
            "type": {
              "const": "settingsChanged",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scope"
          ],
          "type": "object"
        },
        {
          "description": "Pushed system notice or transient status warning.",
          "properties": {
            "level": {
              "$ref": "#/$defs/NoticeLevel"
            },
            "message": {
              "type": "string"
            },
            "type": {
              "const": "notice",
              "type": "string"
            }
          },
          "required": [
            "type",
            "level",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "SettingId": {
      "description": "A unique identifier for a setting descriptor (1–64 characters, `[a-zA-Z0-9_.-]`).",
      "pattern": "^[a-zA-Z0-9_.-]{1,64}$",
      "type": "string"
    },
    "SettingsScope": {
      "description": "Target scope of a settings page.",
      "oneOf": [
        {
          "enum": [
            "app"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "provider": {
              "$ref": "#/$defs/ProviderId"
            }
          },
          "required": [
            "provider"
          ],
          "type": "object"
        }
      ]
    },
    "SourceKind": {
      "description": "Strategy kind that acquired the metric.",
      "enum": [
        "cli",
        "web",
        "oauth",
        "api",
        "localProbe",
        "dashboard",
        "unknown"
      ],
      "type": "string"
    },
    "StatusIndicator": {
      "description": "High-level service status indicator.",
      "enum": [
        "none",
        "minor",
        "major",
        "critical",
        "maintenance",
        "unknown"
      ],
      "type": "string"
    },
    "Topic": {
      "description": "Subscription topics supported by the IPC engine.",
      "enum": [
        "snapshot",
        "settings",
        "notices",
        "unknown"
      ],
      "type": "string"
    }
  },
  "$id": "https://github.com/bavanchun/ariadusage/schemas/ipc.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ClientMessage"
    },
    {
      "$ref": "#/$defs/ServerMessage"
    }
  ],
  "description": "Top-level message for IPC v1 framing, covering both client requests and server pushes.",
  "title": "IpcMessage",
  "x-status": "draft"
}
