          "maxItems": 24,
          "type": "array"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "rows"
      ],
      "type": "object"
    },
    "EngineInfo": {
      "description": "Information about the running engine daemon.",
      "properties": {
        "refreshing": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "refreshing"
      ],
      "type": "object"
    },
    "EngineSnapshot": {
      "description": "Complete Snapshot v1 emitted by the AriadUsage engine.",
      "properties": {
        "engine": {
          "$ref": "#/$defs/EngineInfo",
          "description": "Engine daemon metadata."
        },
        "generatedAt": {
          "description": "Timestamp when this snapshot was assembled.",
          "type": "string"
        },
        "providers": {
          "description": "Snapshots for each configured provider.",
          "items": {
            "$ref": "#/$defs/ProviderSnapshot"
          },
          "type": "array"
        },
        "schemaVersion": {
          "description": "Schema version, fixed to 1 for Snapshot v1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "staleAfterSeconds": {
          "description": "Seconds after which clients should consider this snapshot stale.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "generatedAt",
        "staleAfterSeconds",
        "engine",
        "providers"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Standard machine-readable error codes for IPC failures.",
      "enum": [
        "unsupportedMessage",
        "invalidRequest",
        "payloadTooLarge",
        "internalError",
        "notFound",
        "unknown"
      ],
      "type": "string"
    },
    "Identity": {
      "description": "Identity and account provenance for a provider.",
      "properties": {
        "accountEmail": {
          "type": [
            "string",
            "null"
          ]
        },
        "accountId": {
          "type": [
            "string",
            "null"
          ]
        },
        "accountOrganization": {
          "type": [
            "string",
            "null"
          ]
        },
        "loginMethod": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        },
        "providerId": {
          "$ref": "#/$defs/ProviderId"
        }
      },
      "required": [
        "providerId"
      ],
      "type": "object"
    },
    "IpcError": {
      "description": "Structured IPC error carrying a machine-readable code and static safe message.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Metric": {
      "description": "Envelope for metric values that carries freshness, honesty, and provenance.\n\nInvariant: `value` is present if and only if `state` is `MetricState::Value` or `MetricState::Stale`.",
      "else": {
        "not": {
          "required": [
            "value"
          ]
        }
      },
      "if": {
        "properties": {
          "state": {
            "enum": [
              "value",
              "stale"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "properties": {
        "asOf": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricError"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/MetricState"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/RateWindow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "confidence"
      ],
      "then": {
        "required": [
          "value"
        ]
      },
      "type": "object"
    },
