            "boolean",
            "null"
          ]
        },
        "remaining": {
          "format": "double",
          "type": "number"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "remaining"
      ],
      "type": "object"
    },
    "DetailRow": {
